# Sanity (헤드리스 CMS) — 값이 없으면 로컬 샘플 콘텐츠로 자동 폴백됩니다.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# 사이트 절대 URL (sitemap/JSON-LD/메타에 사용)
NEXT_PUBLIC_SITE_URL=https://facta.kr

# 페이즈2: GEO 분석 백엔드(LLM) 연동 시 사용
OPENAI_API_KEY=

# ADMIN 팩 — DB(Supabase) · 로그 수집 · 문의/진단 저장
SUPABASE_URL=
# 서버 전용 service role 키 (새 형식 sb_secret_... 또는 예전 형식 eyJ... JWT). 절대 NEXT_PUBLIC_ 접두어 쓰지 말 것.
SUPABASE_SERVICE_ROLE_KEY=
# IP 해시용 솔트 — 32자 이상 무작위 문자열
IP_HASH_SALT=
# 보존기간 크론(/api/cron/retention) 인증용 비밀
CRON_SECRET=
# ADMIN 팩 ② 에서 사용 — 관리자 세션 쿠키 서명 비밀
ADMIN_SESSION_SECRET=
# ADMIN 팩 ② 에서 사용 — "아이디:권한:scrypt해시" 를 쉼표로 이은 계정 목록 (npm run admin:hash 로 생성)
ADMIN_ACCOUNTS=
# 선택 — 있으면 새 문의 접수 시 Resend REST API 로 알림 메일 발송
RESEND_API_KEY=
NOTIFY_EMAIL=
